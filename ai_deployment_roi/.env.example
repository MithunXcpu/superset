# Copy to .env and export it before running narrative.py.
# Leave NVIDIA_API_KEY empty to use the offline template.

NVIDIA_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct
# auto uses NVIDIA when NVIDIA_API_KEY is set, and the offline template otherwise.
LLM_PROVIDER=auto
# mock (default) falls back to the template if the API call fails. error raises.
LLM_FALLBACK=mock
AI_ROI_DATABASE_URL=postgresql://ai_roi:ai_roi_demo@localhost:5433/ai_roi
